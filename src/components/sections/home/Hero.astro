---
// components
import Container from "../../elements/Container.astro"
import Text from "../../elements/Text.astro"
import Heading from "../../elements/Heading.astro"
import ImageContainer from "../../elements/ImageContainer.astro"
import Link from "../../elements/Link.astro"

// assets
import peter from "../../../assets/images/peter.jpg";
---

<Container variant={"xl"} class="flex flex-col gap-8 min-h-screen">
    <Text variant={'xl'} class="text-base-900 lg:max-w-1/3 md:max-w-1/2 w-full">
        Hey! I specialise in <span id="rotating-phrases" aria-live="polite"></span><span id="rotating-cursor" class="ml-1 inline-block" aria-hidden="true"></span>
    </Text>
    <Container class="flex md:flex-row flex-col gap-8">
        <Container class="md:flex-2 flex flex-col items-start gap-4">
            <Link variant={'button'} href="/contact">Available for work</Link>
            <Heading tagName="h1" tagSize="h1">Jamie Gore</Heading>
        </Container>
        <Container class="h-full md:h-[500px] flex-1">
            <ImageContainer src={peter} alt="Jamie Gore" />
        </Container>
    </Container>
</Container>

<style>
    #rotating-phrases { display:inline-block; white-space:nowrap; vertical-align:middle; }
    #rotating-cursor {
        width: 0.6ch;
        background: currentColor;
        display: inline-block;
        vertical-align: middle;
        animation: blink 1s steps(1) infinite;
        height: 1em;
        margin-left: 0.25rem;
    }
    @keyframes blink { 50% { opacity: 0 } }
</style>

<script type="module">
    const phrases = [
        "percussion oriented solutions architecture...",
        "rhythmic UI/UX experiences",
        "groovy product design",
        "modular audio tooling"
    ];

    const typeSpeed = 60; // ms per character when typing
    const deleteSpeed = 40; // ms per character when deleting
    const pauseAfterType = 1200; // ms to wait after full phrase typed

    function wait(ms){ return new Promise(r => setTimeout(r, ms)); }

    function copyFontStyles(fromEl, toEl) {
        const cs = getComputedStyle(fromEl);
        const props = [
            'font-family','font-size','font-weight','font-style','letter-spacing',
            'text-transform','word-spacing','font-variant','font-stretch','line-height'
        ];
        props.forEach(p => toEl.style.setProperty(p, cs.getPropertyValue(p)));
        toEl.style.whiteSpace = 'nowrap';
    }

    async function reserveWidthForLongestPhrase(targetEl, phrases) {
        try { await document.fonts.ready; } catch (e) { /* ignore */ }
        const temp = document.createElement('span');
        copyFontStyles(targetEl, temp);
        temp.style.visibility = 'hidden';
        temp.style.position = 'absolute';
        temp.style.left = '-9999px';
        document.body.appendChild(temp);
        let maxW = 0;
        for (const p of phrases) {
            temp.textContent = p;
            const w = temp.getBoundingClientRect().width;
            if (w > maxW) maxW = w;
        }
        document.body.removeChild(temp);
        targetEl.style.minWidth = Math.ceil(maxW) + 8 + 'px';
        const cs = getComputedStyle(targetEl);
        if (!targetEl.style.minHeight) targetEl.style.minHeight = cs.lineHeight;
    }

    let resizeTimer = null;

    async function startRotator(){
        const el = document.getElementById('rotating-phrases');
        if(!el) return;

        await reserveWidthForLongestPhrase(el, phrases);

        window.addEventListener('resize', () => {
            if (resizeTimer) clearTimeout(resizeTimer);
            resizeTimer = setTimeout(() => reserveWidthForLongestPhrase(el, phrases), 150);
        });

        let idx = 0;
        while(true){
            const text = phrases[idx];
            for(let i=1;i<=text.length;i++){
                el.textContent = text.slice(0,i);
                await wait(typeSpeed);
            }
            await wait(pauseAfterType);
            while(el.textContent.length > 0){
                el.textContent = el.textContent.slice(0,-1);
                await wait(deleteSpeed);
            }
            await wait(250);
            idx = (idx + 1) % phrases.length;
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startRotator);
    } else {
        startRotator();
    }
</script>

