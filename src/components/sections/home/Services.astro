---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import Dropdown from "../../elements/Dropdown.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";

// content
const services = [
    { 
        title: "Touring & Live Performance",
        text: "Jamie Gore brings the energy and excitement of live music to every venue - whether its a larger international tour or a smaller jazz residency."
    },
    { 
        title: "Drum Tracking",
        text: "Jamie thrives in the studio, taking real pleasure in the process of curating a soundscape & part(s) fit for purpose. Whether in person or remote tracking, Jamie is a consummate professional who will always go the extra mile to ensure the best possible result."
    },
    { 
        title: "Teching",
        text: "Teching goes hand in hand with all drummers. What sets Jamie apart is his unique drive to create Systems & SOPs that guarantee comfort & confidence on the road, no matter the circumstances."
    }
]
---

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">Services</Heading>
    <div class="flex flex-col gap-4">
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                services.map((service, index) => (
                    <Dropdown title=`${index + 1}. ${service.title}` text={service.text} />  
                ))
            }       
        </Container>
        <ContainerBottom />    
    </div>

</Container>