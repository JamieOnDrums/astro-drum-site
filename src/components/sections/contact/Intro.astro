---
// components
import Heading from "../../elements/Heading.astro";
import Container from "../../elements/Container.astro";
import Text from "../../elements/Text.astro";
---

<Container
  variant={"xl"}
  class="text-center text-base-900 flex flex-col items-center"
>
  <Heading tagName="h1" tagSize="h1">Contact</Heading>
  <div class="max-w-3xl flex flex-col gap-4">
    <Text variant={"xl"}>Let's Work Together!</Text>
    <Text variant={"sm"}>Need some rhythm? Let's talk.</Text>
    <Text variant={"sm"}
      >Currently accepting new projects. Response time: 24-48 hours.</Text
    >
  </div>
</Container>
